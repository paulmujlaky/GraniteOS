diff --git a/qapi/ui.json b/qapi/ui.json
index 21a0301e9a..00cdb53cf8 100644
--- a/qapi/ui.json
+++ b/qapi/ui.json
@@ -1448,6 +1448,16 @@
 { 'struct'  : 'DisplaySDL',
   'data'    : { '*grab-mod'   : 'HotKeyMod' } }
 
+##
+# @DisplayWasm:
+#
+# WebAssembly display options.
+#
+# @channel: BroadcastChannel used by the browser display client.
+##
+{ 'struct': 'DisplayWasm',
+  'data': { '*channel': 'str' } }
+
 ##
 # @DisplayType:
 #
@@ -1482,6 +1493,8 @@
