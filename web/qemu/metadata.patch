 # @dbus: Start a D-Bus service for the display.  (Since 7.0)
 #
+# @wasm: Stream display updates to a browser BroadcastChannel.
+#
 # Since: 2.12
 ##
 { 'enum'    : 'DisplayType',
@@ -1494,7 +1507,8 @@
     { 'name': 'curses', 'if': 'CONFIG_CURSES' },
